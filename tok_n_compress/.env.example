# Conversation Compressor Skill Configuration

# LLM Provider Settings (configure based on your setup)
LLM_PROVIDER=your_llm_provider
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gpt-4o-mini  # or your preferred model for summarization

# Database settings
DB_PATH=./checkpoints.db

# Compression thresholds
TOKEN_THRESHOLD=80000      # Trigger compression when context reaches this token count
TOPIC_SHIFT_SENSITIVITY=0.5  # Sensitivity threshold for detecting topic shifts (0-1)

# Summarization settings
SUMMARY_MAX_LENGTH=256     # Maximum length of generated summaries in tokens
KEY_PROMPT_LIMIT=3         # Maximum number of key prompts to extract per segment